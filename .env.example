# These are only needed for local dev. When deploying via Vercel, set them
# in Vercel → Project → Settings → Environment Variables instead.

# Supabase — from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — from https://console.anthropic.com/
ANTHROPIC_API_KEY=
